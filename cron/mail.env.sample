# Configuration for cron/aptfleet-mail.sh
# Copy to /etc/aptfleet/mail.env (the .deb package already installs it there), adjust, then:
#   chmod 600 /etc/aptfleet/mail.env     (may contain the SMTP password)
# The file is sourced by bash: KEY="value", no spaces around the "=".

# --- Report -----------------------------------------------------------------

# Options for aptfleet.py. The wrapper adds --no-progress and --html itself.
#   --local          check this server, without SSH
#   --details        changelogs and CVE descriptions (collapsible in the HTML)
#   --kev-recent 7   CVEs recently added to CISA KEV
#   --no-refresh     no apt-get update (needed if the job does not run as root
#                    and the user has no passwordless sudo)
# Instead of --local you can also check hosts centrally via SSH, e.g.
#   APTFLEET_ARGS="--inventory /etc/aptfleet/hosts.ini --ssh-config /etc/aptfleet/ssh.conf"
APTFLEET_ARGS="--local --details --kev-recent 7"

# Path to aptfleet.py (default: ../aptfleet.py relative to this wrapper)
#APTFLEET="/opt/aptfleet/aptfleet.py"
#PYTHON="python3"

# Host name in subject and file name (default: hostname)
#REPORT_NAME="web1"

# Also keep HTML reports here; reports older than REPORT_KEEP_DAYS days are deleted.
# Empty = no archive.
#REPORT_DIR="/var/lib/aptfleet"
#REPORT_KEEP_DAYS=30

# --- Mail -------------------------------------------------------------------

# Recipients, separate several with commas
MAIL_TO="admin@example.com"
# Sender (default: aptfleet@<hostname -f>)
#MAIL_FROM="aptfleet@example.com"
#MAIL_SUBJECT_PREFIX="[aptfleet]"

# When to send a mail:
#   problems  only if aptfleet.py does not return 0 (security update, open
#             KEV vulnerability, host unreachable, check incomplete) - default
#   always    on every run
MAIL_WHEN="problems"

# Show the HTML report as the mail content (1) or only attach it (0). It is always attached.
#MAIL_HTML_INLINE=1

# Mail delivery:
#   sendmail  local MTA (postfix, msmtp-mta, nullmailer, ...) - default
#   smtp      straight to an SMTP server via curl, no MTA needed
#   print     only print the mail to stdout (for testing)
MAIL_TRANSPORT="sendmail"
#SENDMAIL="/usr/sbin/sendmail"

# Only for MAIL_TRANSPORT=smtp:
#   smtps://...:465                   TLS from the start
#   smtp://...:587 + SMTP_STARTTLS=1  require STARTTLS
#SMTP_URL="smtps://mail.example.com:465"
#SMTP_STARTTLS=0
#SMTP_USER="updates@example.com"
#SMTP_PASSWORD="secret"
