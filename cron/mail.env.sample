# Konfiguration für cron/aptfleet-mail.sh
# Kopieren nach /etc/aptfleet/mail.env (das .deb-Paket legt sie dort schon an), anpassen, dann:
#   chmod 600 /etc/aptfleet/mail.env     (enthält ggf. das SMTP-Passwort)
# Die Datei wird von bash eingelesen: KEY="wert", keine Leerzeichen um das "=".

# --- Report -----------------------------------------------------------------

# Optionen für aptfleet.py. --no-progress und --html setzt der Wrapper selbst.
#   --local          den eigenen Server prüfen, ohne SSH
#   --details        Changelogs und CVE-Beschreibungen (im HTML aufklappbar)
#   --kev-recent 7   zuletzt auf CISA-KEV aufgenommene CVEs
#   --no-refresh     kein apt-get update (nötig, wenn der Job nicht als root läuft
#                    und der User kein sudo ohne Passwort hat)
# Statt --local geht auch der zentrale Betrieb per SSH, z. B.
#   APTFLEET_ARGS="--inventory /etc/aptfleet/hosts.ini --ssh-config /etc/aptfleet/ssh.conf"
APTFLEET_ARGS="--local --details --kev-recent 7"

# Pfad zu aptfleet.py (Default: ../aptfleet.py relativ zu diesem Wrapper)
#APTFLEET="/opt/aptfleet/aptfleet.py"
#PYTHON="python3"

# Name des Hosts in Betreff und Dateiname (Default: hostname)
#REPORT_NAME="rootserver"

# HTML-Reports zusätzlich hier ablegen; ältere als REPORT_KEEP_DAYS Tage werden gelöscht.
# Leer = nicht archivieren.
#REPORT_DIR="/var/lib/aptfleet"
#REPORT_KEEP_DAYS=30

# --- Mail -------------------------------------------------------------------

# Empfänger, mehrere mit Komma getrennt
MAIL_TO="admin@example.com"
# Absender (Default: aptfleet@<hostname -f>)
#MAIL_FROM="aptfleet@example.com"
#MAIL_SUBJECT_PREFIX="[updates]"

# Wann eine Mail kommt:
#   problems  nur wenn aptfleet.py nicht 0 liefert (Security-Update, offene
#             KEV-Lücke, Host nicht erreichbar, Prüfung unvollständig) – Default
#   always    bei jedem Lauf
MAIL_WHEN="problems"

# HTML-Report als Mailinhalt anzeigen (1) oder nur anhängen (0). Angehängt wird er immer.
#MAIL_HTML_INLINE=1

# Versandweg:
#   sendmail  lokaler MTA (postfix, msmtp-mta, nullmailer, …) – Default
#   smtp      direkt an einen SMTP-Server per curl, kein MTA nötig
#   print     Mail nur auf stdout ausgeben (zum Testen)
MAIL_TRANSPORT="sendmail"
#SENDMAIL="/usr/sbin/sendmail"

# Nur für MAIL_TRANSPORT=smtp:
#   smtps://…:465               TLS von Anfang an
#   smtp://…:587 + STARTTLS=1   STARTTLS erzwingen
#SMTP_URL="smtps://mail.example.com:465"
#SMTP_STARTTLS=0
#SMTP_USER="updates@example.com"
#SMTP_PASSWORD="geheim"
