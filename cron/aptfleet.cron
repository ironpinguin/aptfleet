# Example for /etc/cron.d/aptfleet
#   cp cron/aptfleet.cron /etc/cron.d/aptfleet
# Files in /etc/cron.d need a user column and must not have a dot in their name.

SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
# Wrapper output (errors only, e.g. mail delivery failed) is sent here by cron mail
MAILTO=root

# Daily at 06:30 as root (apt-get update without sudo). The wrapper mails the report itself.
# cron ignores the wrapper's exit code, so "|| true" is not needed.
30 6 * * *  root  /opt/aptfleet/cron/aptfleet-mail.sh /etc/aptfleet/mail.env

# Variant without root: dedicated user, package lists from apt-daily (APTFLEET_ARGS with --no-refresh)
#30 6 * * *  updates  /opt/aptfleet/cron/aptfleet-mail.sh /home/updates/aptfleet-mail.env
