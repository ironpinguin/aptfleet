# Cron job for aptfleet-mail (from package aptfleet).
# To enable it, first adjust /etc/aptfleet/mail.env (MAIL_TO, mail delivery),
# test with `sudo aptfleet-mail --dry-run | less`, then uncomment the line below.

SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
# Wrapper output (errors only, e.g. mail delivery failed) is sent here by cron mail
MAILTO=root

# Daily at 06:30 as root (apt-get update without sudo). The wrapper mails the report itself.
#30 6 * * *  root  /usr/bin/aptfleet-mail /etc/aptfleet/mail.env
