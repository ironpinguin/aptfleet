# Cronjob für updates-report (aus dem Paket updates-report).
# Zum Aktivieren erst /etc/updates-report.env anpassen (MAIL_TO, Versandweg),
# mit `sudo updates-report --dry-run | less` testen, dann die Zeile unten einkommentieren.

SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
# Ausgaben des Wrappers (nur Fehler, z. B. Mailversand fehlgeschlagen) gehen per cron-Mail hierhin
MAILTO=root

# Täglich um 06:30 als root (apt-get update ohne sudo). Den Report verschickt der Wrapper selbst.
#30 6 * * *  root  /usr/bin/updates-report /etc/updates-report.env
